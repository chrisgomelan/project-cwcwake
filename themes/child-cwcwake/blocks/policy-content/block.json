{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cwc/policy-content",
	"version": "1.0.0",
	"title": "Policy Content",
	"category": "theme",
	"icon": "shield",
	"description": "Legal page body — intro paragraph plus a card containing labeled clauses (used on Privacy Policy and Terms & Conditions).",
	"textdomain": "child-cwcwake",
	"supports": {
		"align": ["full"],
		"html": false,
		"anchor": true
	},
	"attributes": {
		"intro": {
			"type": "string",
			"default": ""
		},
		"sections": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"render": "file:./render.php",
	"style": "file:./style.css"
}
