{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cwc/before-footer-cta",
  "title": "Before Footer CTA",
  "category": "theme",
  "description": "Full-width call-to-action section with background image, gradient overlay, and Book Now button.",
  "supports": { "html": false, "align": ["full"] },
  "textdomain": "child-cwcwake",
  "attributes": {
    "title": {
      "type": "string",
      "default": "START YOUR OWN"
    },
    "titleAccent": {
      "type": "string",
      "default": "STORY"
    },
    "accentFirst": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "default": "Whether you're a first-timer or a pro, the water is waiting. Plan your visit to the world's premier cable park today."
    },
    "buttonLabel": {
      "type": "string",
      "default": "BOOK NOW"
    },
    "buttonUrl": {
      "type": "string",
      "default": "#book"
    },
    "secondaryBtnLabel": {
      "type": "string",
      "default": ""
    },
    "secondaryBtnUrl": {
      "type": "string",
      "default": ""
    },
    "backgroundImage": {
      "type": "string",
      "default": ""
    },
    "overlayGradient": {
      "type": "string",
      "default": ""
    }
  },
  "style": "file:./style.css",
  "render": "file:./render.php"
}
