{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cwc/other-rooms",
	"version": "1.0.0",
	"title": "Other Rooms",
	"category": "theme",
	"icon": "schedule",
	"description": "Bottom-of-page card showcasing the sibling room types as overlay-labelled thumbnails. Mirrors the style of the Room Info card with a blue accent bar.",
	"textdomain": "child-cwcwake",
	"supports": {
		"align": ["full"],
		"html": false,
		"anchor": true
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Other Rooms"
		},
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"render": "file:./render.php",
	"style": "file:./style.css"
}
