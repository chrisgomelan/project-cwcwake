# ===========================================
# WordPress wp-content .gitignore
# Track: custom themes & plugins you develop
# Ignore: everything that can be reinstalled
# ===========================================

# --- Uploads ---
# Tracked so collaborators get all media assets.
# Ignore WordPress-generated thumbnail sizes to keep the repo lean.
uploads/**/*-[0-9]*x[0-9]*.*

# --- Upgrade files ---
upgrade/

# --- Cache & backups ---
cache/
backup-db/
backups/
blogs.dir/
*.bak
*.swp

# --- WordPress default/bundled themes ---
# These ship with WordPress — no need to track them.
# Add more lines here if new default themes appear.
themes/twentytwentythree/
themes/twentytwentyfour/
themes/twentytwentyfive/

# --- Third-party plugins (installed via WP admin / composer) ---
# Ignore everything in plugins/ by default …
plugins/*
# … but keep the directory itself and any custom plugins we build.
# Note: gitignore re-includes need both the folder AND its contents,
# otherwise files inside an excluded directory stay excluded even
# when listed individually. Add a matching pair per custom plugin.
!plugins/.gitkeep
!plugins/cwc-accommodations/
!plugins/cwc-accommodations/**

# --- Dependency & build artifacts ---
node_modules/
vendor/
*.map

# --- OS & editor junk ---
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- PHP & WordPress temp files ---
*.php.bak
php_errorlog
debug.log
wp-content-debug.log

# --- Advanced Custom Fields Pro local JSON (uncomment if needed) ---
# acf-json/

# --- WP language files (auto-downloaded per environment) ---
languages/

project-cwcwake/

/designs